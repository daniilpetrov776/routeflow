# Оставьте пустым в dev: запросы идут на same-origin (/api), Vite проксирует на backend.
# Нужно только если клиент и сервер на разных хостах (например, прод).
# VITE_API_URL=http://localhost:5001
# VITE_YANDEX_MAPS_API_KEY больше не используется на клиенте
# API ключ должен быть настроен только на сервере (YANDEX_MAPS_API_KEY)
